# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider (openai | gemini)
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Modeles de chat (optionnels — defauts : gpt-5.5 / gemini-2.0-flash)
# OPENAI_MODEL=gpt-5.5
# GEMINI_MODEL=gemini-2.0-flash

# Cle Admin d'organisation OpenAI — requise UNIQUEMENT pour l'onglet Coûts de l'admin
# (API /v1/organization/costs). Distincte de OPENAI_API_KEY.
# A creer sur https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=your-openai-admin-key

# RAG embeddings (OpenAI, indépendant de AI_PROVIDER — utilise OPENAI_API_KEY)
EMBEDDING_MODEL=text-embedding-3-small

# Plafond de messages chat par utilisateur et par heure (défaut : 60)
CHAT_RATE_LIMIT_PER_HOUR=60

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
